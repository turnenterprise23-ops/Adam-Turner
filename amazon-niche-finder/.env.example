PORT=3001
NODE_ENV=development

# Rainforest API (https://www.rainforestapi.com/)
# Sign up for an API key at rainforestapi.com
RAINFOREST_API_KEY=your_rainforest_api_key_here

# Keepa API (https://keepa.com/#!api)
# Alternative data source - sign up at keepa.com
KEEPA_API_KEY=your_keepa_api_key_here

# Which API provider to use: "rainforest" or "keepa"
API_PROVIDER=rainforest

# Amazon marketplace (default: uk)
MARKETPLACE=uk
