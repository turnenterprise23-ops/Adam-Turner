# Server
PORT=3000
NODE_ENV=production

# Session secret - REQUIRED: generate a strong random string
# e.g. openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string

# Database path (defaults to ./lastmanstanding.db)
DATABASE_PATH=./lastmanstanding.db

# Default admin credentials (only used on first run)
ADMIN_EMAIL=admin@lastmanstanding.com
ADMIN_PASSWORD=change-me-to-a-strong-password
